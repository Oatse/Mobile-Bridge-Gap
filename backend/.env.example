# ─── Environment ─────────────────────────────────────────────────────────────
# Set to "production" when using Cloudflare Tunnel for remote access.
# In production mode: tunnel logging is enabled, API token is enforced.
NODE_ENV=development

# Server
PORT=3000

# ─── Security (Cloudflare Tunnel) ────────────────────────────────────────────
# API token for authenticating mobile requests through the tunnel.
# Leave empty to disable token auth (local development).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_TOKEN=

# Public-facing production URL (for CORS and logging)
PRODUCTION_URL=https://api.mbridgegap.my.id

# Rate limiting (per IP)
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=60000

# ─── LM Studio ──────────────────────────────────────────────────────────────
LM_STUDIO_URL=http://localhost:1234
LM_STUDIO_MODEL=gemma-4-e4b-it

# Inference
INFERENCE_TIMEOUT_MS=30000
MAX_OUTPUT_TOKENS=200

# Image Processing
IMAGE_MAX_DIMENSION=384

# ─── Depth Estimation ───────────────────────────────────────────────────────
ENABLE_DEPTH_ESTIMATION=true
DEPTH_INPUT_SIZE=518
DEPTH_DEBUG_LOGGING=false
DEPTH_INFERENCE_TIMEOUT_MS=10000
